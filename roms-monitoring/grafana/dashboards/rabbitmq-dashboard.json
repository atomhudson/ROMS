    "panels": [
        {
            "title": "📬 Queue Depth — Messages Ready",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "fillOpacity": 20,
                        "lineWidth": 2
                    },
                    "unit": "short"
                }
            },
            "targets": [
                {
                    "expr": "rabbitmq_queue_messages_ready",
                    "legendFormat": "{{queue}} ready",
                    "refId": "A"
                },
                {
                    "expr": "rabbitmq_queue_messages_unacked",
                    "legendFormat": "{{queue}} unacked",
                    "refId": "B"
                }
            ]
        },
        {
            "title": "⚡ Message Rates (per second)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "fillOpacity": 10,
                        "lineWidth": 2
                    },
                    "unit": "ops"
                }
            },
            "targets": [
                {
                    "expr": "rate(rabbitmq_queue_messages_published_total[1m])",
                    "legendFormat": "{{queue}} published/s",
                    "refId": "A"
                },
                {
                    "expr": "rate(rabbitmq_queue_messages_delivered_total[1m])",
                    "legendFormat": "{{queue}} delivered/s",
                    "refId": "B"
                },
                {
                    "expr": "rate(rabbitmq_queue_messages_acked_total[1m])",
                    "legendFormat": "{{queue}} acked/s",
                    "refId": "C"
